# --- Telegram ---
# Crea el bot con @BotFather y pega aqui el token.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Tu chat id: escribe al bot y abre
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# --- Web privada ---
# SIN esto la web queda ABIERTA a cualquiera que sepa la IP. Ponlo siempre.
# Usa algo largo: hay bots recorriendo internet probando IPs y contraseñas.
WEB_PASSWORD=cambia-esto-por-algo-muy-largo-y-unico

# Para compartir con un colega sin darle TU contraseña, usa esto en vez de
# WEB_PASSWORD. Formato usuario:clave separados por comas. Así puedes
# quitarle el acceso a uno sin cambiar la del resto.
# WEB_USERS=pavel:mi-clave-larga,luis:otra-clave-larga

# Ponlo a true SOLO si has montado HTTPS (docker-compose.https.yml).
# Marca las cookies como seguras.
WEB_HTTPS=false

# --- HTTPS (opcional pero recomendado) ---
# Un dominio gratis en duckdns.org y Caddy hace el resto solo.
# DOMINIO=tuflow.duckdns.org
# EMAIL=tucorreo@ejemplo.com
# Enlace que aparece en los mensajes de Telegram
WEB_URL=http://TU_IP:8080

# --- Amazon (opcional) ---
# Sin esto Amazon simplemente no se vigila; el resto funciona igual.
KEEPA_API_KEY=
